# Stagwell AI — server-side configuration (Vercel project environment variables).
# Nothing here is ever sent to the browser. Copy to .env.local for `vercel dev`; never commit real values.

# ── Models (the Kimi conversation's broker: api/_lib/llm/broker.js) ──────────
# Each slot is "provider/model". Providers: kimi (OpenAI-compatible gateway), openai, xai, anthropic.
# An empty slot is skipped. With every slot empty or every call failing, the funnel runs deterministically.
KIMI_LLM_ENABLED=true
KIMI_PRIMARY_MODEL=kimi/kimi-for-coding-highspeed
KIMI_SECONDARY_MODEL=openai/gpt-4o-mini
KIMI_TERTIARY_MODEL=
KIMI_PRIMARY_TIMEOUT_MS=7000     # per attempt; a kimi/ slot defaults to 7000 (reasoning model), others to 4000
KIMI_SECONDARY_TIMEOUT_MS=4000
KIMI_TERTIARY_TIMEOUT_MS=4000
KIMI_MODEL_TIMEOUT_MS=           # one value for all three slots, if preferred
KIMI_TOTAL_DEADLINE_MS=12000

# Provider keys — only the ones the chain above actually uses.
LLM_API_KEY=            # Kimi gateway key (existing name; KIMI_API_KEY is accepted as an alias)
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=kimi-for-coding-highspeed   # legacy default for the older /api/ask modes
OPENAI_API_KEY=

# Voice — "Chat with me" (KIMI.md §4f). Needs OPENAI_API_KEY.
VOICE_ENABLED=on
VOICE_MODEL=gpt-realtime
VOICE_NAME=marin
VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_SESSION_SECONDS=900
VOICE_SOFT_SECONDS=600
VOICE_SILENCE_MUTE_SECONDS=90
VOICE_MINT_PER_HOUR=6
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Leads (api/lead.js → api/_lib/leads/leadService.js) ──────────────────────
# HubSpot private-app token with crm.objects.contacts.read/write. With no token the
# service runs in MOCK mode: the mapped contact is logged, a fake id is returned, nothing is stored.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_MOCK=true          # force mock even when a token is present
KIMI_HUBSPOT_ENABLED=true
# Optional second destination, kept from the earlier build: any https endpoint that takes a JSON POST.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_AUTH=

# ── Flags ────────────────────────────────────────────────────────────────────
KIMI_ENABLED=true
KIMI_ANALYTICS_ENABLED=true
# Health probe (GET /api/ask?health=1&probe=1 makes one tiny call per provider). Set to require a token.
KIMI_HEALTH_TOKEN=
