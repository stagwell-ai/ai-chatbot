# Stagwell AI — server-side configuration (Vercel project environment variables).
# Nothing here is ever sent to the browser. Copy to .env.local for `vercel dev`; never commit real values.

# ── Models (the Kimi conversation's broker: api/_lib/llm/broker.js) ──────────
# Each slot is "provider/model". Providers: kimi (OpenAI-compatible gateway), openai, xai, anthropic.
# An empty slot is skipped. With every slot empty or every call failing, the funnel runs deterministically.
KIMI_LLM_ENABLED=true
KIMI_PRIMARY_MODEL=kimi/kimi-for-coding-highspeed
KIMI_SECONDARY_MODEL=openai/gpt-4o-mini
KIMI_TERTIARY_MODEL=
KIMI_PRIMARY_TIMEOUT_MS=7000     # per attempt; a kimi/ slot defaults to 7000 (reasoning model), others to 4000
KIMI_SECONDARY_TIMEOUT_MS=4000
KIMI_TERTIARY_TIMEOUT_MS=4000
KIMI_MODEL_TIMEOUT_MS=           # one value for all three slots, if preferred
KIMI_TOTAL_DEADLINE_MS=12000

# Provider keys — only the ones the chain above actually uses.
LLM_API_KEY=            # Kimi gateway key (existing name; KIMI_API_KEY is accepted as an alias)
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=kimi-for-coding-highspeed   # legacy default for the older /api/ask modes
OPENAI_API_KEY=

# Voice — "Chat with me" (KIMI.md §4f). Needs OPENAI_API_KEY.
VOICE_ENABLED=on
VOICE_MODEL=gpt-realtime
VOICE_NAME=marin
VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# how easily the agent is interrupted. semantic (default) reads meaning; server is a plain level gate.
VOICE_VAD=semantic
VOICE_VAD_EAGERNESS=low          # low | medium | high | auto — low waits longer and interrupts least
VOICE_VAD_INTERRUPT=on           # off = the visitor cannot cut the agent off at all
VOICE_VAD_THRESHOLD=0.65         # server VAD only: higher is deafer to a noisy room
VOICE_VAD_SILENCE_MS=700         # server VAD only: the pause that ends a turn
VOICE_VAD_PREFIX_MS=300          # server VAD only
VOICE_NOISE_REDUCTION=far_field  # far_field (laptop/room) | near_field (headset) | off
VOICE_SESSION_SECONDS=900
VOICE_SOFT_SECONDS=600
VOICE_SILENCE_MUTE_SECONDS=90
# per-IP voice sessions per hour; 0 = no limit (the default while voice is in beta — set a number to turn it on)
VOICE_MINT_PER_HOUR=0
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ── "Call my phone" (api/callback.js) ────────────────────────────────────────
# Where a callback request is forwarded (a Make.com scenario). SERVER ONLY — it is a
# write endpoint, so it must never reach the browser. Unset, nothing is forwarded and
# the endpoint answers 502 rather than pretending the call was booked.
CALLBACK_WEBHOOK_URL=

# ── Leads (api/lead.js → api/_lib/leads/leadService.js) ──────────────────────
# HubSpot SERVICE KEY with crm.objects.contacts.read/write (and crm.schemas.contacts.write
# while the one-time property setup runs). Private apps were retired in favour of service
# keys in Sep 2026: HubSpot → Development → Keys → Service keys. Both are sent as
# `Authorization: Bearer …`, so either works here. With no key the service runs in MOCK
# mode: the mapped contact is logged, a fake id is returned, nothing is stored.
# Whoever holds this key can also run the schema setup at /hubspot-setup — the page
# compares what you paste against this value and nothing else.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
# Set ONLY when the contact is first created, never on a later touch: an owner
# written on every update hands the account back each time that person returns,
# and a stage written on every update drags an Opportunity back to MQL because
# they booked a second demo. Owner is a HubSpot USER id (a number) — find it at
# Settings → Users, or ask the CRM to list owners.
HUBSPOT_OWNER_ID=
HUBSPOT_LIFECYCLE_STAGE=marketingqualifiedlead
# A property write raises NOTHING in HubSpot — no timeline entry, no feed item,
# no notification, and for a contact that already existed, not even a place among
# recently-created. So every live lead also writes a note on the contact's
# timeline and a task in someone's queue (assigned to HUBSPOT_OWNER_ID above when
# it is set). Both need crm.objects.notes.* and crm.objects.tasks.* on the key;
# /hubspot-setup checks and tells you. Either can be turned off without a deploy.
HUBSPOT_NOTE_ENABLED=true
HUBSPOT_TASK_ENABLED=true
# The numeric id of a HubSpot list every lead is added to. HubSpot has no public
# API for a saved CRM view, and a connector can only make a STATIC list — which is
# useless on its own, and perfect here: the site pushes each contact into it as it
# lands, so the list collects without anyone maintaining it and without needing
# Marketing Hub for an active list. Unset, nothing is added. Needs crm.lists.write.
HUBSPOT_LIST_ID=
# The HubSpot FORM the lead is submitted to before the Contacts API write. Her
# workflow triggers on a form submission event, which a Contacts API write does not
# raise, so without this leads land in the CRM and never enrol or route. The guid is
# on the form itself (Marketing → Forms → the form → Share / embed code). Unset, no
# form is posted and everything else is unchanged. HUBSPOT_PORTAL_ID must also be set.
HUBSPOT_FORM_GUID=
# Which contact property on that form takes the product they asked about. The default
# is the portal's own stagwell_ai_form_solution_drop_down — note the INTERNAL name is
# "solution", though its label reads "Stagwell AI Form Product Drop Down".
# A submission is validated against the FORM, not the contact schema, and the form's
# fields are named by whoever built it. The first live one was rejected with
# "Required field 'work_email' is missing" — that form's email field is a custom
# property called work_email. So the mapping is config: ourName:theirName, comma
# separated. Unmapped fields go out under their own name; mapped to nothing, they are
# dropped, for a form that has no such field (an unknown field fails the whole
# submission just as surely as a missing one).
#   # The origin the form submission reports as its page. HubSpot reads the SITE DOMAIN
# off it and quarantines anything whose domain is not on the portal's tracking list
# ("Unregistered Site Domain") — silently, after answering 200. Whatever is set here
# must be added at HubSpot → Settings → Tracking & Analytics → Tracking Code →
# Domains. Change it when the site moves.
SITE_ORIGIN=https://stagwell-ai-prototypes.vercel.app
# Every hostname the site answers on. The submission is filed under the one the
# visitor was actually using, so all of these must be on the HubSpot tracking list.
# A Host header we do not recognise is ignored in favour of SITE_ORIGIN, because
# that value ends up in somebody's CRM.
SITE_HOSTS=stagwell.ai,beta.stagwell.ai,stagwell-ai-prototypes.vercel.app
# false stops the form submission reporting a page at all. HubSpot can only
# quarantine an "Unregistered Site Domain" when there is a domain to object to, and it
# reads that off the page. The page is recorded in stagwell_ai_landing_page regardless,
# so this costs attribution inside HubSpot and nothing else.
HUBSPOT_FORM_SEND_PAGE=true
HUBSPOT_FORM_FIELD_MAP=email:work_email,jobtitle:title
HUBSPOT_FORM_FIELD_MAP=
HUBSPOT_FORM_PRODUCT_FIELD=stagwell_ai_form_solution_drop_down
# What to send when the visitor ticked NOTHING. The portal's product field carries a
# "Not Sure" option for exactly this, which is the default and the honest answer — it
# must match one of that field's options verbatim. `none` sends the field empty instead.
HUBSPOT_FORM_PRODUCT_FALLBACK=Not Sure
# A bridge for when the site renames a product and the CRM's option list has not
# caught up. An option that field has never heard of fails the WHOLE submission, not
# just that field. ourName:theirName, comma separated. Empty is the healthy state —
# the names are meant to match, and a test fails when they do not.
HUBSPOT_FORM_PRODUCT_ALIASES=Machine OS:The Machine
HUBSPOT_MOCK=true          # force mock even when a token is present
KIMI_HUBSPOT_ENABLED=true
# Optional second destination, kept from the earlier build: any https endpoint that takes a JSON POST.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_AUTH=

# ── Flags ────────────────────────────────────────────────────────────────────
KIMI_ENABLED=true
KIMI_ANALYTICS_ENABLED=true
# Health probe (GET /api/ask?health=1&probe=1 makes one tiny call per provider). Set to require a token.
KIMI_HEALTH_TOKEN=
